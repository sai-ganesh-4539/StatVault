# ── App ──
APP_NAME=StatVault API
APP_ENV=development
APP_PORT=8000

# ── Database ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=statvault
DB_USER=statvault
DB_PASSWORD=statvault
DATABASE_URL=postgresql+asyncpg://statvault:statvault@localhost:5433/statvault

# ── ML Model Paths ──
ML_MODELS_DIR=../ml/models
CLUSTER_PROFILES_PATH=../ml/models/cluster_profiles.json
MARKET_VALUE_FEATURES_PATH=../ml/models/market_value_feature_names.txt

# ── External APIs ──
API_FOOTBALL_KEY=your_api_football_key_here
FOOTBALL_DATA_ORG_KEY=your_football_data_org_key_here
STATSBOMB_KEY=your_statsbomb_key_here
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# ── PGVector / Embeddings ──
PGVECTOR_COLLECTION=statvault_embeddings
HF_TOKEN=your_huggingface_token_here