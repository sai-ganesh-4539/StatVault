# ==========================================
# STATVAULT AI - .gitignore
# ==========================================

# 1. DATA & REPORTS (Ignore CSV and JSON files)
*.csv
*.json

# 2. MACHINE LEARNING MODELS (Explicitly ensure PKL files are tracked)
!*.pkl

# 3. Python Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 4. Virtual Environments
venv/
env/
ENV/
.venv

# 5. Jupyter Notebooks Checkpoints
.ipynb_checkpoints/

# 6. IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 7. Environment Variables & Secrets (Never push these)
.env
.env.local
kaggle.json